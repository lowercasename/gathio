<main class="page">
  <h2 class="mb-4">Admin panel</h2>

  <div class="alert alert-success" role="alert">
    Authenticated as admin: <strong>{{adminEmail}}</strong>. This session expires in 24 hours.
  </div>

  <p>Enter an event or event group ID or full URL to open it in admin editing mode.</p>

  <div class="form-group">
    <label for="eventInput">Event or event group ID or URL</label>
    <input type="text" class="form-control" id="eventInput" placeholder="e.g. abc123, https://{{domain}}/abc123 or https://{{domain}}/group/abc123">
  </div>
  <div class="form-group text-center">
    <button id="goToEvent" class="button button--primary w-50"
      data-admin-token="{{adminToken}}"
      data-admin-email="{{adminEmail}}">Edit</button>
  </div>

  <hr>

  <h4 class="mb-3">Passkey sign-in</h4>
  <p>
    Register this device as a passkey so you can log in without requesting a new
    email magic link each time.
  </p>
  <div class="form-group text-center">
    <button id="registerPasskey" class="button button--primary w-50"
      data-admin-email="{{adminEmail}}">Add this device as a passkey</button>
  </div>
  <p id="passkeyStatus" class="text-center small"></p>

  <script>
    // Persist admin session so future visits don't require a new magic link
    (function() {
      const expiry = new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString();
      setAdminSession('{{adminToken}}', '{{adminEmail}}', expiry);
    })();

    document.getElementById('goToEvent').addEventListener('click', function () {
      var adminToken = this.dataset.adminToken;
      var adminEmail = this.dataset.adminEmail;
      var input = document.getElementById('eventInput').value.trim();
      if (!input) return;
      // Strip any leading scheme/host and leading slash, drop query string
      var path = input.replace(/^https?:\/\/[^\/]+\//, '').replace(/^\//, '').split('?')[0];
      if (!path) return;
      // A "group/<id>" path (or full group URL) targets the event group route;
      // anything else is treated as a bare event ID.
      var groupMatch = path.match(/^group\/(.+)$/);
      var targetPath = groupMatch ? 'group/' + groupMatch[1] : path;
      window.location.href = '/' + targetPath
        + '?adminToken=' + encodeURIComponent(adminToken)
        + '&adminEmail=' + encodeURIComponent(adminEmail);
    });

    document.getElementById('eventInput').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') document.getElementById('goToEvent').click();
    });

    // Register this device as a passkey for passkey sign-in
    document.getElementById('registerPasskey').addEventListener('click', async function () {
      var btn = this;
      var status = document.getElementById('passkeyStatus');
      var session = getAdminSession();
      if (!session) { status.textContent = 'No active admin session. Please log in again.'; return; }
      btn.disabled = true;
      status.textContent = '';
      try {
        var res = await fetch('/passkey/register/options', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ adminToken: session.token, adminEmail: session.email })
        });
        if (!res.ok) {
          var data = await res.json().catch(function () { return {}; });
          throw new Error(data.error || 'Could not start passkey registration.');
        }
        var opts = await res.json();
        var attResp = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: opts, useAutoRegister: true });
        var regRes = await fetch('/passkey/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: session.email, response: attResp, deviceName: (navigator.userAgent || '').slice(0, 64) })
        });
        var regData = await regRes.json().catch(function () { return {}; });
        if (!regRes.ok) throw new Error(regData.error || 'Passkey registration failed.');
        // Refresh the admin session from the freshly minted one.
        if (regData.token && regData.email && regData.expiry) {
          setAdminSession(regData.token, regData.email, regData.expiry);
        }
        status.textContent = 'Passkey registered. You can now log in without an email link.';
        btn.textContent = 'Passkey registered';
      } catch (e) {
        status.textContent = e.message || 'Registration failed.';
        btn.disabled = false;
      }
    });
  </script>
</main>
