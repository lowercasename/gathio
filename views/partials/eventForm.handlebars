<input type="hidden" name="magicLinkToken" value="{{magicLinkToken}}" x-ref="magicLinkToken">
<div class="form-group">
  <label for="eventName" >{{t "common.eventname" }}</label>
  <div class="form-group ">
    <input type="text" class="form-control" id="eventName" name="eventName" placeholder="{{t "views.partials.snappy" }}" x-model="data.eventName" >
  </div>
</div>
<div class="form-group">
  <label for="eventLocation" >{{t "common.eventlocation" }}</label>
  <div class="form-group ">
    <input type="text" class="form-control" id="eventLocation" name="eventLocation" placeholder="{{t "views.event.locationdesc" }}" x-model="data.eventLocation">
  </div>
</div>
<div class="form-group">
  <label for="eventStart" >{{t "common.eventstart" }}</label>
  <div class="form-group">
    <input type="datetime-local" class="form-control" id="eventStart" name="eventStart"  x-model="data.eventStart" x-on:blur="updateEventEnd">
  </div>
</div>
<div class="form-group">
  <label for="eventEnd" >{{t "common.eventend" }}</label>
  <div class="form-group ">
    <input type="datetime-local" class="form-control" id="eventEnd" name="eventEnd"  x-model="data.eventEnd">
  </div>
</div>
<div class="form-group">
  <label for="timezone" >{{t "common.timezone" }}</label>
  <div class="form-group ">
    <select class="select2" id="timezone" name="timezone" x-ref="timezone"></select>
  </div>
</div>
<div class="form-group">
  <label for="eventDescription" >{{t "views.partials.eventform.eventdescription" }}</label>
  <div class="form-group ">
    <textarea class="form-control expand" id="eventDescription" name="eventDescription" placeholder="{{t "views.event.editlater" }}" x-model="data.eventDescription" ></textarea>
    <small class="form-text">{{{t "views.partials.mdsupport" }}}</small>
  </div>
</div>
<div class="form-group">
  <label for="eventURL">{{t "views.partials.eventform.eventurl" }}</label>
  <div class="form-group ">
    <input type="url" class="form-control" id="eventURL" name="eventURL" placeholder="https://example.com" x-model="data.eventURL">
    <small class="form-text">{{t "views.partials.eventform.eventurldesc" }}</small>
  </div>
</div>
<div class="form-group">
  <label for="eventImage" >{{t "common.coverimg" }}</label>
  <div class="form-group ">
    <div class="image-preview" id="event-image-preview">
      <label for="image-upload" id="event-image-label">{{t "views.partials.choosefile" }}</label>
      <input type="file" name="imageUpload" id="event-image-upload" accept="image/jpeg,image/gif,image/png" x-ref="eventImageUpload" />
    </div>
    <small class="form-text">{{t "views.partials.recommendeddimensions" }}</small>
    {{#if eventData.image}}
      <div class="form-group my-2">
        <button type="button" class="button button--danger" id="deleteImage">{{t "views.partials.delimg" }}</button>
      </div>
    {{/if}}
  </div>
</div>
<div class="form-group">
  <label for="hostName" >{{t "views.partials.eventform.hostname" }}</label>
  <div class="form-group ">
    <input type="text" class="form-control" id="hostName" name="hostName" placeholder="{{t "views.partials.eventform.hostnamedesc" }}" x-model="data.hostName" >
  </div>
</div>
<div class="form-group">
  <label for="creatorEmail" >{{t "views.partials.eventform.creatoremail" }}</label>
  <div class="form-group ">
    <input type="email" class="form-control" id="creatorEmail" name="creatorEmail" placeholder="{{t "views.partials.wontshow" }}" x-model.fill="data.creatorEmail" {{#if creatorEmail}}value="{{creatorEmail}}" readonly{{/if}}>
    <small class="form-text">{{t "views.partials.creatoremaildesc" }}</small>
  </div>
</div>
<div class="form-group">
  <label>{{t "views.partials.eventform.options" }}</label>
  {{#if showPublicEventList}}
    <div class="feature-card" :class="data.publicCheckbox && 'feature-card--active'">
      <label class="feature-card__header">
        <i class="fas fa-globe feature-card__icon" aria-hidden="true"></i>
        <span class="feature-card__text">
          <span class="feature-card__title">{{t "views.partials.eventform.featurepublictitle" }}</span>
          <span class="feature-card__desc">{{t "views.partials.eventform.publicevent" }}</span>
        </span>
        <input class="feature-card__toggle" type="checkbox" id="publicEventCheckbox" name="publicCheckbox" x-model="data.publicCheckbox">
      </label>
    </div>
  {{/if}}
  <div class="feature-card" :class="data.interactionCheckbox && 'feature-card--active'">
    <label class="feature-card__header">
      <i class="fas fa-comment feature-card__icon" aria-hidden="true"></i>
      <span class="feature-card__text">
        <span class="feature-card__title">{{t "views.partials.eventform.featurecommentstitle" }}</span>
        <span class="feature-card__desc">{{t "views.interaction" }}</span>
      </span>
      <input class="feature-card__toggle" type="checkbox" id="interactionCheckbox" name="interactionCheckbox" x-model="data.interactionCheckbox">
    </label>
  </div>
  <div class="feature-card" :class="data.joinCheckbox && 'feature-card--active'">
    <label class="feature-card__header">
      <i class="fas fa-user-plus feature-card__icon" aria-hidden="true"></i>
      <span class="feature-card__text">
        <span class="feature-card__title">{{t "views.partials.eventform.featurersvptitle" }}</span>
        <span class="feature-card__desc">{{t "views.join" }}</span>
      </span>
      <input class="feature-card__toggle" type="checkbox" id="joinCheckbox" name="joinCheckbox" x-model="data.joinCheckbox">
    </label>
    <div class="feature-card__body" x-show="data.joinCheckbox">
      <div class="feature-card feature-card--nested" :class="data.approveRegistrationsCheckbox && 'feature-card--active'">
        <label class="feature-card__header">
          <span class="feature-card__text">
            <span class="feature-card__title">{{t "views.partials.eventform.featureapprovaltitle" }}</span>
            <span class="feature-card__desc">{{t "views.partials.eventform.featureapprovaldesc" }}</span>
          </span>
          <input class="feature-card__toggle" type="checkbox" id="approveRegistrationsCheckbox" name="approveRegistrationsCheckbox" x-model="data.approveRegistrationsCheckbox" {{#if eventData.approveRegistrations}}checked{{/if}}>
        </label>
      </div>
      <div class="form-group mt-2 mb-0">
        <label for="maxAttendees">{{t "views.partials.eventform.maxattendees" }}</label>
        <input type="number" min="1" class="form-control" id="maxAttendees" name="maxAttendees" placeholder="{{t "views.partials.eventform.nolimit" }}" x-model="data.maxAttendees">
      </div>
      <div class="mt-3" id="customQuestionsContainer">
        <label>{{t "views.partials.eventform.customquestions" }}</label>
        <small class="form-text">{{t "views.partials.eventform.customquestionsdesc" }}</small>
        <template x-for="(question, questionIndex) in customQuestions" :key="question._uid">
          <div class="card my-2 custom-question-card">
            <div class="card-body py-2 px-3">
              <div class="form-group">
                <label :for="`customQuestionPrompt${questionIndex}`">{{t "views.partials.eventform.questionprompt" }}</label>
                <input type="text" class="form-control" maxlength="200" :id="`customQuestionPrompt${questionIndex}`" placeholder="{{t "views.partials.eventform.questionpromptplaceholder" }}" x-model="question.prompt">
              </div>
              <div class="form-group">
                <label :for="`customQuestionType${questionIndex}`">{{t "views.partials.eventform.questiontype" }}</label>
                <select class="form-control" :id="`customQuestionType${questionIndex}`" x-model="question.type" x-on:change="customQuestionTypeChanged(question)">
                  <option value="text">{{t "views.partials.eventform.questiontypetext" }}</option>
                  <option value="multipleChoice">{{t "views.partials.eventform.questiontypemultiplechoice" }}</option>
                </select>
              </div>
              <div class="form-group" x-show="question.type === 'multipleChoice'">
                <label>{{t "views.partials.eventform.questionoptions" }}</label>
                <template x-for="(option, optionIndex) in question.options" :key="option._uid">
                  <div class="custom-question-option mb-2">
                    <input type="text" class="form-control" maxlength="200" :id="`customQuestion${questionIndex}Option${optionIndex}`" :placeholder="'{{t "views.partials.eventform.optionplaceholder" }} ' + (optionIndex + 1)" x-model="option.text">
                    <button type="button" class="button button--danger button--sm" x-on:click="removeCustomQuestionOption(question, optionIndex)" aria-label="{{t "views.partials.eventform.removeoption" }}" title="{{t "views.partials.eventform.removeoption" }}"><i class="fas fa-times"></i></button>
                  </div>
                </template>
                <button type="button" class="button button--outline-primary button--sm" x-on:click="addCustomQuestionOption(question)" x-show="question.options.length < maxCustomQuestionOptions">
                  <i class="fas fa-plus"></i> {{t "views.partials.eventform.addoption" }}
                </button>
              </div>
              <button type="button" class="button button--danger button--sm" :id="`removeCustomQuestion${questionIndex}`" x-on:click="removeCustomQuestion(questionIndex)">
                <i class="fas fa-trash"></i> {{t "views.partials.eventform.removequestion" }}
              </button>
            </div>
          </div>
        </template>
        <button type="button" class="button button--outline-primary" id="addCustomQuestionButton" x-on:click="addCustomQuestion" x-show="customQuestions.length < maxCustomQuestions">
          <i class="fas fa-plus"></i> {{t "views.partials.eventform.addquestion" }}
        </button>
      </div>
    </div>
  </div>
  <div class="feature-card" :class="data.eventGroupCheckbox && 'feature-card--active'">
    <label class="feature-card__header">
      <i class="fas fa-layer-group feature-card__icon" aria-hidden="true"></i>
      <span class="feature-card__text">
        <span class="feature-card__title">{{t "views.partials.eventform.featuregrouptitle" }}</span>
        <span class="feature-card__desc">{{t "views.partials.eventform.eventgroup" }}</span>
      </span>
      <input class="feature-card__toggle" type="checkbox" id="eventGroupCheckbox" name="eventGroupCheckbox" x-model="data.eventGroupCheckbox">
    </label>
    {{!-- eventGroupLinker's x-data lives on an inner div so that x-show above
          still sees the parent form component's `data` rather than the
          linker's own `data` --}}
    <div class="feature-card__body" id="eventGroupData" x-show="data.eventGroupCheckbox">
      <div x-data="eventGroupLinker()">
        <div class="form-group-label" x-show="data.groups.length > 0">
          <label>{{t "views.partials.eventform.eventgrouplinker" }}</label>
        </div>
        <div class="form-group" x-show="data.groups.length > 0">
          <select
            x-ref="eventGroupSelect"
            id="eventGroupSelect"
            name="eventGroupSelect"
            class="form-control"
            x-on:change="selectGroup"
          >
            <option></option>
            <template x-for="group in data.groups">
              <option :value="group.id" x-text="group.name"></option>
            </template>
          </select>
        </div>
        <button type="button" class="button button--outline-primary w-100 text-center" x-on:click="manualGroupInputVisible = !manualGroupInputVisible">
          {{t "views.partials.eventform.groupbutton" }} <i class="fas" :class="{'fa-caret-down': !manualGroupInputVisible, 'fa-caret-up': manualGroupInputVisible}"></i>
        </button>
        <div
          class="form-group slider"
          id="manualGroupInput"
          :class="manualGroupInputVisible && 'slider--open'"
          :style="manualGroupInputVisible && {height: $el.scrollHeight+`px`}"
          :aria-hidden="!manualGroupInputVisible"
        >
          <label for="eventGroupID" class="mt-2">{{t "common.eventgroupid" }}</label>
          <div class="form-group">
            <input type="text" class="form-control text-monospace" id="eventGroupID" name="eventGroupID" x-model="data.eventGroupID" x-on:input="resetGroupSelector">
            <small class="form-text">{{t "views.partials.eventform.eventgroupid" }}</small>
          </div>
          <label for="eventGroupEditToken">{{t "views.partials.eventform.eventgroupedittoken" }}</label>
          <div class="form-group mb-0">
            <input type="text" class="form-control text-monospace" id="eventGroupEditToken" name="eventGroupEditToken" x-model="data.eventGroupEditToken" x-on:input="resetGroupSelector">
            <small class="form-text">{{t "views.partials.eventform.eventgroupedittoken" }}</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="form-group">
  <div class="col-12">
    <div
      class="alert alert-danger"
      role="alert"
      x-show="errors.length > 0"
    >
      <p><i class="fas fa-exclamation-triangle"></i> {{t "views.partials.fixerrors" }}</p>
      <ul>
        <template x-for="error in errors">
          <li x-html="error.message"></li>
        </template>
      </ul>
    </div>
  </div>
</div>
